# Executables & Binaries
bin/*
!bin/.gitkeep
*.exe
!ms-dlp.exe

# Rust build artifacts
target/
*.pdb

# Sensitive & Private configurations (Cookies etc.)
private/*
!private/.gitkeep

# Native Messaging Host generated manifests & task history
native_host/com.*.downloader.json
native_host/tasks/*
!native_host/tasks/.gitkeep

# Python cache
__pycache__/
*.pyc
.sentry-native/

# Download outputs & temporary files
output/*
!output/.gitkeep
temp_download/
*.tmp

# Logs
logs/
*.log

# OS & Editor files
desktop.ini
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
